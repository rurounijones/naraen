{
  "name": "naraen",
  // The dev service of docker-compose.yml, started with the whole local stack
  // (SeaweedFS, its bucket, and the server) and sharing the server's network
  // namespace: SSH, HTTPS and S3 are on localhost here as on the host, where
  // compose also publishes them on 127.0.0.1.
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "runServices": ["s3", "s3-init", "naraen", "dev"],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/naraen",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "portsAttributes": {
    "2222": { "label": "SSH (LFS authenticate)" },
    "8443": { "label": "HTTPS (Batch API)" },
    "8333": { "label": "S3 (SeaweedFS)" }
  },
  "postCreateCommand": "sudo chown -R vscode: /go/pkg /home/vscode/.cache && go mod download && go -C tools mod download && pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig",
        "task.vscode-task"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint-v2",
        "go.lintOnSave": "package",
        "editor.formatOnSave": true,
        "gopls": { "formatting.gofumpt": true }
      }
    }
  }
}
